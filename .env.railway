# ══════════════════════════════════════════════════════════════════════════════
# EcoVision AI — Railway Environment Variables Reference
# ══════════════════════════════════════════════════════════════════════════════
#
# INSTRUCTIONS FOR RAILWAY:
#   1. Railway Dashboard → Project → New → Database → PostgreSQL
#   2. Railway Dashboard → Project → New → Database → Redis
#   3. Railway Dashboard → Project → New → GitHub Repo → select ecovision-ai
#   4. Add variables below in Railway Service → Settings → Variables
#   5. Connect PostgreSQL & Redis reference variables (DATABASE_URL, REDIS_URL)
#
# ══════════════════════════════════════════════════════════════════════════════

ENVIRONMENT=production
DEBUG=false
APP_VERSION=2.0.0

# ── Security ─────────────────────────────────────────────────────────────────
SECRET_KEY=efa9669aa6ab51b5403db0cc61f0ac5c5573c97307db57718cfe7e672182c17c
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── AI Provider (OpenRouter LLM) ─────────────────────────────────────────────
OPENROUTER_API_KEY=REPLACE_WITH_YOUR_OPENROUTER_API_KEY
OPENROUTER_MODEL=mistralai/mistral-7b-instruct

# ── IBM WatsonX AI (Optional) ────────────────────────────────────────────────
WATSONX_API_KEY=REPLACE_WITH_YOUR_IBM_API_KEY
WATSONX_PROJECT_ID=REPLACE_WITH_YOUR_PROJECT_ID
WATSONX_URL=https://us-south.ml.cloud.ibm.com
GRANITE_MODEL_ID=ibm/granite-13b-instruct-v2

# ── Database & Redis (Auto-connected via Railway Postgres & Redis plugins) ──
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# REDIS_URL=${{Redis.REDIS_URL}}

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=*

# ── File Storage ─────────────────────────────────────────────────────────────
UPLOAD_DIR=/tmp/uploads
REPORTS_DIR=/tmp/reports
MAX_UPLOAD_SIZE_MB=10

# ── Feature Flags ────────────────────────────────────────────────────────────
ENABLE_AUDIT_LOG=true
