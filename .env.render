# ══════════════════════════════════════════════════════════════════════════════
# EcoVision AI — Render Secret File Template
# ══════════════════════════════════════════════════════════════════════════════
#
# HOW TO USE:
#   1. Fill in ALL values below
#   2. Render Dashboard → ecovision-backend  → Environment → Secret Files
#      → Add Secret File → Filename: /app/.env → paste contents → Save
#   3. Do the same for ecovision-celery service
#   4. NOTE: DATABASE_URL and REDIS_URL are auto-injected by Render and will
#      override whatever you put here — you can leave them as-is below.
#
# ══════════════════════════════════════════════════════════════════════════════

# ── Core ─────────────────────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
APP_VERSION=2.0.0

# ── Database (auto-overridden by Render fromDatabase injection) ───────────────
DATABASE_URL=postgresql://ecovision:REPLACE_ME@oregon-postgres.render.com/ecovision

# ── Redis (auto-overridden by Render fromService injection) ──────────────────
REDIS_URL=redis://red-REPLACE_ME@oregon-redis.render.com:6379

# ── Security ─────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_64_CHAR_HEX_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── IBM WatsonX AI ───────────────────────────────────────────────────────────
WATSONX_API_KEY=REPLACE_WITH_YOUR_IBM_API_KEY
WATSONX_PROJECT_ID=REPLACE_WITH_YOUR_PROJECT_ID
WATSONX_URL=https://us-south.ml.cloud.ibm.com
GRANITE_MODEL_ID=ibm/granite-13b-instruct-v2

# ── ChromaDB ─────────────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=ecovision_docs

# ── CORS ─────────────────────────────────────────────────────────────────────
# Update this after your frontend deploys on Render
ALLOWED_ORIGINS=https://ecovision-frontend.onrender.com

# ── File Storage (ephemeral on Render free/starter) ──────────────────────────
UPLOAD_DIR=/tmp/uploads
REPORTS_DIR=/tmp/reports
MAX_UPLOAD_SIZE_MB=10

# ── Monitoring (optional) ────────────────────────────────────────────────────
SENTRY_DSN=

# ── Email / SMTP (optional) ──────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM=noreply@ecovision.ai

# ── Feature Flags ────────────────────────────────────────────────────────────
ENABLE_AUDIT_LOG=true
