# EcoVision AI — Production Environment Variables
# Copy to .env and fill ALL values. NEVER commit .env.

ENVIRONMENT=production
DEBUG=false
DATABASE_URL=postgresql://ecovision:STRONG_PASSWORD@db:5432/ecovision
POSTGRES_USER=ecovision
POSTGRES_PASSWORD=STRONG_RANDOM_PASSWORD_HERE
POSTGRES_DB=ecovision
SECRET_KEY=replace_with_64_char_random_hex_string_minimum_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REDIS_URL=redis://:REDIS_PASSWORD@redis:6379
REDIS_PASSWORD=STRONG_REDIS_PASSWORD
WATSONX_API_KEY=your_ibm_watsonx_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
GRANITE_MODEL_ID=ibm/granite-13b-instruct-v2
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION=ecovision_docs
CHROMA_AUTH_TOKEN=STRONG_CHROMA_AUTH_TOKEN
ALLOWED_ORIGINS=https://ecovision.yourdomain.com
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=uploads
REPORTS_DIR=reports
SENTRY_DSN=https://your_key@sentry.io/your_project
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=your_smtp_password
EMAILS_FROM=noreply@ecovision.yourdomain.com
FLOWER_USER=admin
FLOWER_PASSWORD=STRONG_FLOWER_PASSWORD
ENABLE_NOTIFICATIONS=true
ENABLE_AUDIT_LOG=true
