# EcoVision AI — Production Environment Variables Template
# Copy to .env and fill in ALL values. NEVER commit .env.
# Target Infrastructure: Render (Backend/Celery), Vercel (Frontend), Supabase (PostgreSQL), Upstash Redis

ENVIRONMENT=production
DEBUG=false

# ── Database (Supabase PostgreSQL) ───────────────────────────────────────────
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ── Cache & Task Broker (Upstash Redis) ──────────────────────────────────────
REDIS_URL=redis://default:[YOUR-UPSTASH-PASSWORD]@[YOUR-UPSTASH-HOST]:6379

# ── Security & Authentication ────────────────────────────────────────────────
SECRET_KEY=replace_with_64_char_random_hex_string_minimum_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── AI Provider (OpenRouter LLM) ──────────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free

# ── Vector DB & Embeddings (ChromaDB) ────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=ecovision_docs

# ── CORS Configuration (Vercel Frontend URL) ─────────────────────────────────
ALLOWED_ORIGINS=https://ecovision-frontend.vercel.app

# ── Storage & Paths ──────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=/tmp/uploads
REPORTS_DIR=/tmp/reports

# ── Monitoring & Alerts ──────────────────────────────────────────────────────
SENTRY_DSN=

# ── Mail / Notifications ─────────────────────────────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=your_smtp_password
EMAILS_FROM=noreply@ecovision.ai
ENABLE_NOTIFICATIONS=true
ENABLE_AUDIT_LOG=true
